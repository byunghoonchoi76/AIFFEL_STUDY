# ── LLM (vLLM, OpenAI 호환 API) ──
# NGC 카탈로그(nvcr.io/nvidia/vllm)에서 DGX Spark 지원 최신 태그로 교체
VLLM_IMAGE=nvcr.io/nvidia/vllm:CHANGE_ME-py3
# 개발 중에는 openai/gpt-oss-20b로 빠르게 반복, 성능 측정은 120b
LLM_MODEL=openai/gpt-oss-120b
LLM_SERVED_NAME=gpt-oss
# 128GB 통합 메모리를 DB·임베딩과 공유하므로 여유를 둠 (120b ≈ 65GB)
LLM_GPU_MEM_UTIL=0.70
LLM_MAX_MODEL_LEN=32768
# 모델을 ./models에 받아둔 뒤 1로 바꾸면 외부 접속 없이 기동
HF_HUB_OFFLINE=0

# ── 임베딩 (CPU, sentence-transformers) ──
EMBED_MODEL=intfloat/multilingual-e5-large-instruct
EMBED_DIM=1024

# ── DB ──
POSTGRES_PASSWORD=change_me
NEO4J_PASSWORD=change_me_neo4j
NEO4J_USER=neo4j

# ── 분석 파라미터 ──
INDICATORS_PATH=config/indicators.yaml
GRADING_PATH=config/source_grading.yaml
